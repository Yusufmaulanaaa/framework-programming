# BookStore E-Commerce Database Configuration
# Configure these settings for your MySQL database connection

# Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=bookstore_user
DB_PASSWORD=YourSecurePassword123
DB_NAME=bookstore_ecommerce

# Application Settings
APP_PORT=3000
NODE_ENV=development

# Security Settings
JWT_SECRET=YourJWTSecretKeyHere
CORS_ORIGIN=http://localhost:3000
